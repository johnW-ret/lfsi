<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lfsi</ToolCommandName>
    <PackageId>lfsi</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>johnW-ret</Authors>
    <Description>Terminal notebook editor for F# scripts.</Description>
    <RepositoryUrl>https://github.com/johnW-ret/lfsx</RepositoryUrl>
    <PackageOutputPath>$(MSBuildProjectDirectory)/nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Configuration.fs" />
    <Compile Include="Persistence.fs" />
    <Compile Include="TerminalGraphics.fs" />
    <Compile Include="OutputRendering.fs" />
    <Compile Include="SyntaxHighlighting.fs" />
    <Compile Include="FsAutoComplete.fs" />
    <Compile Include="EditorCompletion.fs" />
    <Compile Include="MarkdownRendering.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lfsi.Core\Lfsi.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Consolonia" Version="11.3.9" />
    <PackageReference Update="FSharp.Core" Version="10.1.201" />
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.201" />
    <PackageReference Include="Markdig" Version="0.44.0" />
    <PackageReference Include="MessagePack" Version="2.5.302" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Nerdbank.MessagePack" Version="1.2.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="StreamJsonRpc" Version="2.24.92" />
  </ItemGroup>

</Project>
